# ============ API Keys ============
BIRDEYE_API_KEY=your_birdeye_premium_plus_key
HELIUS_API_KEY=your_helius_business_key
JUPITER_API_KEY=your_jupiter_developer_key

# ============ 前端 API 鉴权 ============
# 前端访问 /api/* 时需要在 header 里带 x-api-token，否则任何能访问端口的人都能操控钱包。
# 留空 = 关闭鉴权（仅当 HOST=127.0.0.1 且确信无外部访问时可这么做）
# 强烈建议设置为一个长随机字符串
API_TOKEN=change_this_to_a_long_random_string

# Webhook 入站（外部推送代币到 /webhook/add-token）
# 已废弃 — webhook 接口不再做鉴权（用户要求）。如需安全请用网络层（防火墙/反代白名单）控制。
WEBHOOK_SECRET=

# ============ 钱包 ============
# 留空 = 启动时交互式提示输入；生产推荐留空，通过 KMS 注入
WALLET_PASSWORD=

# ============ 服务端口 ============
PORT=3001
HOST=0.0.0.0
FRONTEND_URL=http://localhost:5173
# 多个域名/IP 用逗号分隔，例如：http://43.165.7.48:8080,https://mybot.example.com
EXTRA_CORS_ORIGINS=

# ============ 数据库 ============
DATABASE_PATH=./data.db

# ============ 交易策略 - 通用 ============
DEFAULT_BUY_SOL=1
DEFAULT_SLIPPAGE_BPS=300                # 3% 默认滑点
DEFAULT_PRIORITY_FEE_LAMPORTS=1000000   # 0.001 SOL max priority fee
JITO_TIP_LAMPORTS=100000                # Jito tip，0 表示不用 Jito（关闭 MEV protect）

# ============ 止盈 ============
TAKE_PROFIT_GAIN_PCT=100                # 涨 100%（2x）自动全仓卖
RSI_SELL_THRESHOLD=80                   # 15m RSI(7) > 80 立即全仓卖

# ============ 自动逢低买入 ============
AUTO_DIP_BUY_ENABLED=true
AUTO_DIP_BUY_SOL=1                      # 首次买入金额（SOL）
AUTO_DIP_BUY_DROP_24H_PCT=70            # 24h 跌幅 ≥ 70%
AUTO_DIP_BUY_RSI_THRESHOLD=30           # 15m RSI(7) < 30
AUTO_DIP_DCA_DROP_PCT=50                # 相对上次买入价又跌 ≥ 50% → 补仓
AUTO_DIP_DCA_SOL=1                      # 补仓金额（SOL）
AUTO_DIP_MAX_BUYS=5                     # 含 DCA 的最大买入次数

# ============ 监控阈值 ============
FDV_MIN_USD=30000
LP_MIN_USD=10000
MONITOR_CHECK_INTERVAL_MS=300000        # 5 分钟巡检 FDV/LP
AUTO_STRATEGY_INTERVAL_MS=60000         # 1 分钟评估自动策略一次

# ============ RPC ============
SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=${HELIUS_API_KEY}
SOLANA_WS_URL=wss://mainnet.helius-rpc.com/?api-key=${HELIUS_API_KEY}
